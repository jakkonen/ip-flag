{
  "name": "ip-flag",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:chromium": "vite --mode chromium",
    "dev:firefox": "vite --mode firefox",
    "flags": "tsx scripts/build-flags.ts",
    "icons": "tsx scripts/build-icons.ts",
    "build:chromium": "npm run flags && npm run icons && vite build --mode chromium && tsx scripts/write-manifest.ts chromium",
    "build:firefox": "npm run flags && npm run icons && vite build --mode firefox && tsx scripts/write-manifest.ts firefox",
    "build": "npm run build:chromium && npm run build:firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('public/flags',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "flag-icons": "^7.5.0",
    "sharp": "^0.35.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "license": "Apache-2.0"
}
